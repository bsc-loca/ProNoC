// synthesis translate_off
`timescale   1ns/1ns


module pck_injector_test;
	
	import pronoc_pkg::*; 
	
	reg     reset ,clk;
	
	initial begin 
		clk = 1'b0;
		forever clk = #10 ~clk;
	end 
	
	
	smartflit_chanel_t chan_in_all  [NE-1 : 0];
	smartflit_chanel_t chan_out_all [NE-1 : 0];
	
	pck_injct_t pck_injct_in [NE-1 : 0];
	pck_injct_t pck_injct_out[NE-1 : 0];
	
	
	noc_top 	the_noc
	(
		.reset(reset),
		.clk(clk),    
		.chan_in_all(chan_in_all),
		.chan_out_all(chan_out_all)  
	);
		
	reg [NEw-1 : 0] dest_id [NE-1 : 0];
		
	genvar i;
	generate 
	for(i=0; i< NE; i=i+1) begin : endpoints
		packet_injector #( 
			.ENDP_ID(i)		
		)pck_inj(
			//general
			.reset(reset),
			.clk(clk),		
   			//noc port
			.chan_in(chan_out_all[i]),
			.chan_out(chan_in_all[i]),  
			//control interafce
			.pck_injct_in(pck_injct_in[i]),
			.pck_injct_out(pck_injct_out[i])		
		);			
	

		endp_addr_encoder #( .TOPOLOGY(TOPOLOGY), .T1(T1), .T2(T2), .T3(T3), .EAw(EAw),  .NE(NE)) encode1 ( .id(dest_id[i]), .code(pck_injct_in[i].endp_addr));
		
		
	

		initial begin 
			reset = 1'b1;
			pck_injct_in[i].data =0;
			#10
			pck_injct_in[i].class_num=0; 
			pck_injct_in[i].init_weight=1;
			pck_injct_in[i].vc=1;
			pck_injct_in[i].pck_wr=1'b0; 
			#100
			@(posedge clk) #1;
			reset=1'b0;
			#100
			@(posedge clk) #1;
			if(i==2) begin 
				while (pck_injct_out[i].ready[1] == 1'b0) @(posedge clk) #1;
					
				pck_injct_in[i].data='h123456789ABCDEF;
				pck_injct_in[i].size=4;
				dest_id[i]=0;				
				pck_injct_in[i].pck_wr=1'b1;  	
				@(posedge clk)
				pck_injct_in[i].pck_wr=1'b0;  				
			end
			
			#8000
			@(posedge clk)
			$stop;
		end
		
		always @(posedge clk) begin
			if(pck_injct_out[i].pck_wr) begin 
				$display ("pck_inj(%d) got a packet: source=%d, size=%d, data=%h",i,
						pck_injct_out[i].endp_addr,pck_injct_out[i].size,pck_injct_out[i].data);
			end		
			
		end
		
	
	  
	end//for
	endgenerate
       
	



	
	

	
	

endmodule
// synthesis translate_on

