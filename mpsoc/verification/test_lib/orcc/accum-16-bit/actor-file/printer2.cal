package accumulatorv2;
 

 
 actor printer2 () int(size=16) result ==> :
 
  int (size=16) temp :=0;
  int (size=16) temp2 :=0;
  
   action result:[a] ==>
     do
         temp := temp + 1 ;
         temp2:= temp2-((temp / 10)*10);
         
         if temp  = 20
		 then
		   println("The result printer2 is " + a);
	     else
		 //   println("p2: " + temp );
	     end
         
          
     end
 end
