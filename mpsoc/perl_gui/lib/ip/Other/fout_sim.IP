		 fout_GET_FILE_NAME = *filename; 
		 filename++;
	}
	 ${IP}_GET_FILE_NAME = 0; // activate the Verilog Fwrite command
	
	return (& file_ptr[file_prtr]); 
}


void foutbyte( char c){	
	//write content
	${IP}_GET_FILE_CONTENT = c;	
}

void fout_select (char * f){
 	//write file pointer
	${IP}_GET_FLE_PTR = *f;
}

