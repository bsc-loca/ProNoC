FILE *  fopen   (const char *filename, const char *mode){
	//alloacte a new pointer;
	static int file_prtr=0;
	file_prtr++;  

  file_ptr[file_prtr]=file_prtr;
	//write file pointer
	${IP}_GET_FLE_PTR = file_prtr;
