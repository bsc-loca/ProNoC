                                                                                                                                                           'info' => 'Parameter'
                                                                                                                                                         },
                                                                                                                                        'ram_J2WBw' => {
                                                                                                                                                         'info' => undef,
                                                                                                                                                         'redefine_param' => 1,
                                                                                                                                                         'global_param' => 'Parameter',
                                                                                                                                                         'type' => 'Fixed',
                                                                                                                                                         'default' => '(ram_JTAG_CONNECT== "XILINX_JTAG_WB") ? 1+1+ram_JDw+ram_JAw : 1',
                                                                                                                                                         'content' => ''
                                                                                                                                                       },
                                                                                                                                        'ram_JTAG_CONNECT' => {
