                                                                                                                                                              'info' => 'Parameter'
                                                                                                                                                            },
                                                                                                                                              'ram2_J2WBw' => {
                                                                                                                                                                'info' => undef,
                                                                                                                                                                'default' => '(ram2_JTAG_CONNECT== "XILINX_JTAG_WB") ? 1+1+ram2_JDw+ram2_JAw : 1',
                                                                                                                                                                'content' => '',
                                                                                                                                                                'type' => 'Fixed',
                                                                                                                                                                'global_param' => 'Parameter',
                                                                                                                                                                'redefine_param' => 1
                                                                                                                                                              },
