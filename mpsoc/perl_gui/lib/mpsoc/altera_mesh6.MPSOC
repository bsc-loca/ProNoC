                                                                                                                                                      'redefine_param' => 1,
                                                                                                                                                      'global_param' => 'Parameter'
                                                                                                                                                    },
                                                                                                                                       'ram_JSTATUSw' => {
                                                                                                                                                           'info' => 'Parameter',
                                                                                                                                                           'global_param' => 'Parameter',
                                                                                                                                                           'redefine_param' => 1,
                                                                                                                                                           'default' => '8',
                                                                                                                                                           'content' => '',
                                                                                                                                                           'type' => 'Fixed'
                                                                                                                                                         },
                                                                                                                                       'ram_JTAG_CHAIN' => {
                                                                                                                                                             'global_param' => 'Parameter',
                                                                                                                                                             'redefine_param' => 0,
                                                                                                                                                             'default' => '4',
                                                                                                                                                             'content' => '1,2,3,4',
                                                                                                                                                             'type' => 'Combo-box',
                                                                                                                                                             'info' => 'Only used for Virtex 4/5 devices. May be 1, 2, 3, or 4. It is the  BSCANE2 JTAG tap number. The default Jtag tap numbers are:
    4: JTAG runtime memory programmers. 
    3: UART
    1,2: reserved'
                                                                                                                                                           },
                                                                                                                                       'ram_J2WBw' => {
                                                                                                                                                        'info' => undef,
                                                                                                                                                        'redefine_param' => 1,
                                                                                                                                                        'global_param' => 'Parameter',
                                                                                                                                                        'type' => 'Fixed',
                                                                                                                                                        'default' => '(ram_JTAG_CONNECT== "XILINX_JTAG_WB") ? 1+1+ram_JDw+ram_JAw : 1',
                                                                                                                                                        'content' => ''
