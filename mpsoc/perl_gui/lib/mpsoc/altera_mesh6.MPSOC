                                                                                                                                                           'info' => '',
                                                                                                                                                           'global_param' => 'Parameter',
                                                                                                                                                           'redefine_param' => 1,
                                                                                                                                                           'content' => '',
                                                                                                                                                           'default' => '(uart_JTAG_CONNECT== "XILINX_JTAG_WB") ? 1+uart_JSTATUSw+uart_JINDEXw+1+uart_JDw  : 1',
                                                                                                                                                           'type' => 'Fixed'
                                                                                                                                                         },
                                                                                                                                         'uart_JTAG_CONNECT' => {
                                                                                                                                                                  'type' => 'Combo-box',
