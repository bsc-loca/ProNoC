                                                                                                                                       'ram_WB2Jw' => {
                                                                                                                                                        'default' => '(ram_JTAG_CONNECT== "XILINX_JTAG_WB") ? 1+ram_JSTATUSw+ram_JINDEXw+1+ram_JDw  : 1',
                                                                                                                                                        'content' => '',
                                                                                                                                                        'type' => 'Fixed',
