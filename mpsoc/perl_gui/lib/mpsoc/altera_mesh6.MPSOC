                                                                                                                                                        'info' => '',
                                                                                                                                                        'redefine_param' => 1,
                                                                                                                                                        'global_param' => 'Localparam',
                                                                                                                                                        'type' => 'Combo-box',
                                                                                                                                                        'content' => '"ALTERA","XILINX","GENERIC"',
