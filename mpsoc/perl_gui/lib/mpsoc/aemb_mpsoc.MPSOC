                                                                                                                                                         'global_param' => 'Parameter',
                                                                                                                                                         'default' => '8',
                                                                                                                                                         'redefine_param' => 1,
                                                                                                                                                         'type' => 'Fixed',
                                                                                                                                                         'content' => '',
                                                                                                                                                         'info' => 'Parameter'
                                                                                                                                                       },
                                                                                                                                      'ram_J2WBw' => {
                                                                                                                                                       'redefine_param' => 1,
                                                                                                                                                       'type' => 'Fixed',
                                                                                                                                                       'default' => '(ram_JTAG_CONNECT== "XILINX_JTAG_WB") ? 1+1+ram_JDw+ram_JAw : 1',
                                                                                                                                                       'global_param' => 'Parameter',
                                                                                                                                                       'info' => undef,
                                                                                                                                                       'content' => ''
                                                                                                                                                     }
                                                                                                                                    },
