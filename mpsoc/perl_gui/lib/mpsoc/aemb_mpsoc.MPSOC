                                                                                                                                                              'type' => 'Fixed',
                                                                                                                                                              'default' => '(ram1_JTAG_CONNECT== "XILINX_JTAG_WB") ? 1+ram1_JSTATUSw+ram1_JINDEXw+1+ram1_JDw  : 1',
                                                                                                                                                              'redefine_param' => 1,
