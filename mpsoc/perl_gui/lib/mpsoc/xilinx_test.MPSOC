                                                                                                                                                            'global_param' => 'Localparam',
                                                                                                                                                            'type' => 'Combo-box',
                                                                                                                                                            'info' => 'If selected as "ENABLED", the memory content will be initialized at compilation time using MEM_CONTENT_FILE_NAME.'
                                                                                                                                                          },
