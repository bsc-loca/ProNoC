                                                                                                                  },
                                                                                                   'ram_JTAG_CHAIN' => {
                                                                                                                         'global_param' => 'Parameter',
                                                                                                                         'info' => 'Only used for Virtex 4/5 devices. May be 1, 2, 3, or 4. It is the  BSCANE2 JTAG tap number. The default Jtag tap numbers are:
