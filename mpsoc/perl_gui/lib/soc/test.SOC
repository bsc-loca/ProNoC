                                                                                                                         'content' => '"DISABLED","ENABLED"',
                                                                                                                         'info' => 'Enable the Wishbone bus Incrementing burst mode data transfer. Support Linear burst and 4,8,16-beat wrap burst types. ',
                                                                                                                         'global_param' => 'Localparam',
                                                                                                                         'type' => 'Combo-box',
                                                                                                                         'redefine_param' => 1,
                                                                                                                         'default' => '"ENABLED"'
