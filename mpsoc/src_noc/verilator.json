{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Verilator",
            "type": "shell",
            "command": "verilator",
            "args": [
                "-sv", "--language", "1800-2012",
                "--lint-only",
                "${file}"
            ],
            "problemMatcher": [
                "$verilator-error", "$verilator-warning"
            ]
        }
    ]
}